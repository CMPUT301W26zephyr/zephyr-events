<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@+id/bottom_button_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/text_confirm_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[Insert Event Name]"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="16dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#E0E0E0">
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_image_placeholder2"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Event Type: "
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#555555" />
                <TextView
                    android:id="@+id/text_confirm_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="[Insert Event Type]"
                    android:textSize="16sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Date: "
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#555555" />
                <TextView
                    android:id="@+id/text_confirm_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="[Insert Event Date]"
                    android:textSize="16sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Location: "
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#555555" />
                <TextView
                    android:id="@+id/text_confirm_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="[Insert Event Location]"
                    android:textSize="16sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Price: "
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#555555" />
                <TextView
                    android:id="@+id/text_confirm_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="$[Insert Price if Applicable]"
                    android:textSize="16sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Capacity: "
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#555555" />
                <TextView
                    android:id="@+id/text_confirm_capacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="[Insert Capacity if Applicable]"
                    android:textSize="16sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_confirm_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Description. kjasndkjasndkjasndkjnaskjdnsajkdnjaskndjasndjsandkjasndjkasnkdnasjkdnjkasndkjas. "
                android:textSize="16sp"
                android:textColor="#555555" />



        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>