<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_grey">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:paddingTop="32dp"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/button_back2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/black" />

        <TextView
            android:id="@+id/toolbar_title2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Admin Home"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/primary_red"
            android:gravity="center" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Manage Profiles -->
            <TextView
                android:id="@+id/manageProfilesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Manage Profiles"
                android:textColor="@android:color/black"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/userProfiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="#E0E0E0"
                android:minHeight="56dp"
                android:padding="18dp"
                android:text="User Profiles"
                android:textSize="20sp"
                android:drawableStart="@drawable/_iconamoon_profile_light1"
                android:drawablePadding="12dp" />

            <!-- Actions -->
            <TextView
                android:id="@+id/actionsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Actions"
                android:textColor="@android:color/black"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/browseImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="#E0E0E0"
                android:minHeight="56dp"
                android:padding="18dp"
                android:text="Browse Images"
                android:textSize="20sp"
                android:drawableStart="@drawable/_icon3"
                android:drawablePadding="12dp" />

            <TextView
                android:id="@+id/browseEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="#E0E0E0"
                android:minHeight="56dp"
                android:padding="18dp"
                android:text="Browse Events"
                android:textSize="20sp"
                android:drawableStart="@drawable/_search_4"
                android:drawablePadding="12dp" />

            <TextView
                android:id="@+id/systemNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:background="#E0E0E0"
                android:minHeight="56dp"
                android:padding="18dp"
                android:text="System Notifications"
                android:textSize="20sp"
                android:drawableStart="@drawable/_message_square__alert5"
                android:drawablePadding="12dp" />

            <!-- Logs -->
            <TextView
                android:id="@+id/logsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Logs"
                android:textColor="@android:color/black"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statistics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="#E0E0E0"
                android:minHeight="56dp"
                android:padding="18dp"
                android:text="Statistics"
                android:textSize="20sp"
                android:drawableStart="@drawable/_bar_chart_square_6"
                android:drawablePadding="12dp" />

            <TextView
                android:id="@+id/systemLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="#E0E0E0"
                android:minHeight="56dp"
                android:padding="18dp"
                android:text="System Logs"
                android:textSize="20sp"
                android:drawableStart="@drawable/_receipt_lines7"
                android:drawablePadding="12dp" />

            <TextView
                android:id="@+id/termsConditions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E0E0E0"
                android:minHeight="56dp"
                android:padding="18dp"
                android:text="Terms &amp; Conditions"
                android:textSize="20sp"
                android:drawableStart="@drawable/_file_8"
                android:drawablePadding="12dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Nav -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:background="#FAFAFA"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home"
            android:src="@drawable/ic_home"
            android:scaleType="fitCenter"
            android:padding="18dp"
            app:tint="#757575" />

        <ImageButton
            android:id="@+id/nav_my_events"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_my_events"
            android:src="@drawable/ic_confirmation_number"
            android:scaleType="fitCenter"
            android:padding="18dp"
            app:tint="#757575" />

        <ImageButton
            android:id="@+id/nav_create_event"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_create_event"
            android:src="@drawable/ic_add_box"
            android:scaleType="fitCenter"
            android:padding="18dp"
            app:tint="#757575" />

        <ImageButton
            android:id="@+id/nav_scan_qr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_scan_qr"
            android:src="@drawable/ic_qr_code_scanner"
            android:scaleType="fitCenter"
            android:padding="18dp"
            app:tint="#757575" />

        <ImageButton
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_profile"
            android:src="@drawable/ic_person"
            android:scaleType="fitCenter"
            android:padding="18dp"
            app:tint="#757575" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>