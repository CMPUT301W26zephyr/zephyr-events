<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom navigation bar: Home, Tags, Add, Expand, Profile -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@android:color/white"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:elevation="8dp">

    <FrameLayout
        android:id="@+id/bottom_nav_home"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_home_24"
            app:tint="@color/accent"
            android:contentDescription="Home"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottom_nav_ticket"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_tags_24"
            app:tint="@color/black"
            android:contentDescription="Tags"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottom_nav_add"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/sharp_add_24"
            app:tint="@color/black"
            android:contentDescription="Add"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottom_nav_scan"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_fullscreen_24"
            app:tint="@color/black"
            android:contentDescription="Expand"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottom_nav_profile"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person_24"
            android:background="@drawable/bg_edit_avatar_badge"
            android:padding="4dp"
            app:tint="@color/black"
            android:contentDescription="Profile"/>
    </FrameLayout>
</LinearLayout>
