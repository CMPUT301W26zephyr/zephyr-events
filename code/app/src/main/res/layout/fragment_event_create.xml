<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="72dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Details"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary_red"
                android:layout_marginBottom="12dp"/>

            <LinearLayout style="@style/FormLabelRow" android:layout_marginTop="0dp">
                <TextView style="@style/FormLabel" android:text="Event visibility" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_event_visibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_visibility_public"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/visibility_public" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_visibility_private"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/visibility_private" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/private_event_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFF9E6"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning_24"
                    app:tint="#B7950B" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/private_event_warning"
                    android:textColor="#5D4037"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout style="@style/FormLabelRow" android:layout_marginTop="0dp">
                <TextView style="@style/FormAsterisk" />
                <TextView style="@style/FormLabel" android:text="Event Title" />
            </LinearLayout>
            <EditText
                android:id="@+id/input_event_title"
                style="@style/FormInput"
                android:hint="e.g. Beginner Swimming Lessons" />

            <LinearLayout style="@style/FormLabelRow">
                <TextView style="@style/FormLabel" android:text="Event Type" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">
                <AutoCompleteTextView
                    android:id="@+id/eventTypeDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:popupBackground="#FFFFFF"
                    android:textColor="#333333"
                    android:textSize="16sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout style="@style/FormLabelRow">
                <TextView style="@style/FormLabel" android:text="Event Price" />
            </LinearLayout>
            <EditText
                android:id="@+id/input_event_price"
                style="@style/FormInput"
                android:hint="e.g. 50.00"
                android:inputType="numberDecimal" />

            <LinearLayout style="@style/FormLabelRow">
                <TextView style="@style/FormLabel" android:text="Description" />
            </LinearLayout>
            <EditText
                android:id="@+id/input_event_desc"
                style="@style/FormInput"
                android:hint="e.g. Learn piano at your own pace..."
                android:inputType="textCapSentences" />

            <LinearLayout style="@style/FormLabelRow">
                <TextView style="@style/FormLabel" android:text="Waiting List Capacity" android:layout_marginStart="0dp" />
            </LinearLayout>
            <EditText
                android:id="@+id/input_waitlist"
                style="@style/FormInput"
                android:hint="e.g. 67 (Leave blank for unlimited)"
                android:inputType="number" />

            <LinearLayout style="@style/FormLabelRow">
                <TextView style="@style/FormAsterisk" />
                <TextView style="@style/FormLabel" android:text="Attendee Capacity" />
            </LinearLayout>
            <EditText
                android:id="@+id/input_attendee_count"
                style="@style/FormInput"
                android:hint="e.g. 15"
                android:inputType="number" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginVertical="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location &amp; Maps"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary_red"
                android:layout_marginBottom="12dp"/>

            <LinearLayout style="@style/FormLabelRow" android:layout_marginTop="0dp">
                <TextView style="@style/FormAsterisk" />
                <TextView style="@style/FormLabel" android:text="Location Name" />
            </LinearLayout>
            <EditText
                android:id="@+id/input_location"
                style="@style/FormInput"
                android:hint="e.g. Community Rec Centre" />

            <LinearLayout style="@style/FormLabelRow" >
                <TextView style="@style/FormLabel" android:text="Address (Optional)"/>
            </LinearLayout>
            <EditText
                android:id="@+id/input_address"
                style="@style/FormInput"
                android:hint="e.g. 1234 State Avenue" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:background="#E0E0E0">
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_image_placeholder2"/>
            </FrameLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_geolocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Require Geolocation for Registration"
                android:textSize="15sp"
                android:textColor="#000000"
                android:textStyle="bold"
                app:thumbTint="#FFFFFF"
                app:trackTint="@color/primary_red"
                android:checked="true"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginVertical="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registration &amp; Event Dates"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary_red"
                android:layout_marginBottom="12dp"/>

            <LinearLayout style="@style/FormLabelRow" android:layout_marginStart="4dp">
                <TextView style="@style/FormAsterisk" />
                <TextView style="@style/FormLabel" android:text="Registration Period" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/scroll_registration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingHorizontal="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start Date"
                            android:textColor="#888888"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"
                            android:layout_marginStart="4dp"/>
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp">
                            <CalendarView
                                android:id="@+id/calendar_reg_start"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:theme="@style/CustomInlineCalendar" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/column_reg_end"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="End Date"
                            android:textColor="#888888"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"
                            android:layout_marginStart="4dp"/>
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp">
                            <CalendarView
                                android:id="@+id/calendar_reg_end"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:theme="@style/CustomInlineCalendar" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/text_reg_period"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="16dp"
                android:text="Select start and end dates above"
                android:textColor="#F44336"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout style="@style/FormLabelRow" android:layout_marginStart="4dp">
                <TextView style="@style/FormAsterisk" />
                <TextView style="@style/FormLabel" android:text="Official Event Date" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <CalendarView
                    android:id="@+id/calendar_event"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:theme="@style/CustomInlineCalendar" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/text_event_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="24dp"
                android:text="Select an event date above"
                android:textColor="#F44336"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/divider_event_invites"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="@color/light_stroke"
                android:visibility="gone" />

            <TextView
                android:id="@+id/label_event_form_invites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/event_form_section_invites"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/row_invite_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_invite_entrants_private"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="42dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/invite_entrants"
                    android:textAllCaps="false"
                    android:textColor="#424242"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/light_stroke"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_invite_coorganizer"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="42dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/invite_coorganizer"
                    android:textAllCaps="false"
                    android:textColor="#424242"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/light_stroke"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_event"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:insetTop="4dp"
                android:insetBottom="4dp"
                android:minHeight="40dp"
                android:text="@string/delete_event"
                android:textAllCaps="false"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:visibility="gone"
                app:rippleColor="#33D93B3B" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>