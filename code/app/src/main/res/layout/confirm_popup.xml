<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="32dp"
    app:cardCornerRadius="48dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:padding="16dp"/>
        <!--            android:src="@drawable/ic_warning"-->
        <!--            android:background="@drawable/bg_circle_red_light"-->

        <TextView
            android:id="@+id/text_popup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Are you sure?"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/text_popup_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Deleting this event will erase all waiting list entries."
            android:textSize="16sp"
            android:textAlignment="center"
            android:textColor="#BDBDBD"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btn_popup_cancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="CANCEL"
                android:textColor="#FF3B5C"
                android:background="@drawable/bg_button_outline"
                android:textStyle="bold"
                android:textSize="18sp"
                app:backgroundTint="@null"
                />

            <Button
                android:id="@+id/btn_popup_confirm"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="DELETE"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_filled"
                android:textStyle="bold"
                android:textSize="18sp"
                app:backgroundTint="@null"
                />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>

