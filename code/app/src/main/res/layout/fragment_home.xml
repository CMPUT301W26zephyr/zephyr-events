<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".view.HomeFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top Navigation Area -->
    <LinearLayout
        android:id="@+id/top_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore"
                android:textSize="16sp"
                android:textColor="#333333" />

            <TextView
                style="@style/TxtTitle"
                android:textColor="#FF3B5C"
                android:text="Your Community!" />
        </LinearLayout>
            <!-- Search Icon -->
        <ImageView
            android:id="@+id/btn_search"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search"
            app:tint="#333333" />
    </LinearLayout>

    <!-- Selection Tabs -->
    <!-- Featured Events Header -->
    <LinearLayout
        android:id="@+id/featured_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@+id/top_nav">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Featured Events"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View All"
            android:textColor="#FF3B5C"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- The Carousel -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/carousel_featured"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/featured_header" />

    <!-- Dots Indicator -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_dots"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="@android:color/transparent"
        app:tabBackground="@drawable/dot_full"
        app:tabGravity="center"
        app:tabIndicatorHeight="0dp"
        app:tabMaxWidth="24dp"
        app:tabPaddingStart="12dp"
        app:tabPaddingEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/carousel_featured"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progress_bar_featured"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/carousel_featured"
        app:layout_constraintBottom_toBottomOf="@id/carousel_featured"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>