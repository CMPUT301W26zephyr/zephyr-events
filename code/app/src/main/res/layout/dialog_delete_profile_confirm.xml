<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_dialog_surface">

    <ImageView
        android:id="@+id/iconWarning"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_warning_24"
        app:tint="@color/danger"/>

    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Are you sure?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"/>

    <TextView
        android:id="@+id/txtDialogMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Deleting your profile will erase all waiting list entries, ticketing, and personal information."
        android:textSize="14sp"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/dialog_action_button_height"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="CANCEL"
            android:textColor="@color/accent"
            android:background="@drawable/bg_button_outline"
            android:textAllCaps="true"
            android:textSize="14sp"
            app:backgroundTint="@null"/>

        <Button
            android:id="@+id/btnDialogConfirm"
            android:layout_width="0dp"
            android:layout_height="@dimen/dialog_action_button_height"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="SAVE"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_filled"
            android:textAllCaps="true"
            android:textSize="14sp"
            app:backgroundTint="@null"/>
    </LinearLayout>
</LinearLayout>
