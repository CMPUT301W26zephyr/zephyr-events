<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <include
        android:id="@+id/top_bar"
        layout="@layout/layout_top_bar"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@+id/bottom_button_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout style="@style/FormLabelRow" android:layout_marginTop="0dp">
                <TextView style="@style/FormAsterisk" />
                <TextView style="@style/FormLabel" android:text="Event Title" />
            </LinearLayout>

            <EditText
                android:id="@+id/input_event_title"
                style="@style/FormInput"
                android:hint="e.g. Beginner Swimming Lessons" />

            <LinearLayout style="@style/FormLabelRow">
                <TextView style="@style/FormAsterisk" />
                <TextView style="@style/FormLabel"
                    android:text="Event Type" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="#CCCCCC">
                <AutoCompleteTextView
                    android:id="@+id/eventTypeDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:inputType="none"
                    android:paddingHorizontal="12dp"
                    android:textColor="#333333"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout style="@style/FormLabelRow">
                <TextView style="@style/FormAsterisk" />
                <TextView style="@style/FormLabel"
                    android:text="Event Price" />
            </LinearLayout>

            <EditText
                android:id="@+id/input_event_price"
                style="@style/FormInput"
                android:hint="e.g. $50.00"
                android:inputType="numberDecimal" />

            <LinearLayout style="@style/FormLabelRow">
                <TextView style="@style/FormAsterisk" />
                <TextView style="@style/FormLabel"
                    android:text="Description" />
            </LinearLayout>

            <EditText
                android:id="@+id/input_event_desc"
                style="@style/FormInput"
                android:hint="e.g. Learn piano at your own pace..."
                android:inputType="textCapSentences" />

            <LinearLayout style="@style/FormLabelRow">
                <TextView style="@style/FormLabel"
                    android:text="Waiting List Capacity"
                    android:layout_marginStart="0dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/input_waitlist"
                style="@style/FormInput"
                android:hint="e.g. 67"
                android:inputType="number" />

            <LinearLayout style="@style/FormLabelRow">
                <TextView style="@style/FormAsterisk" />
                <TextView style="@style/FormLabel" android:text="Attendee Count" />
            </LinearLayout>

            <EditText
                android:id="@+id/input_attendee_count"
                style="@style/FormInput"
                android:layout_marginBottom="24dp"
                android:hint="e.g. 15"
                android:inputType="number" />

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/bottom_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:id="@+id/next_button"
            layout="@layout/button_primary" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>