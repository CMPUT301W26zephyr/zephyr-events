<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/dialog_surface_corner_radius"
    app:cardElevation="0dp"
    android:layout_margin="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DRAW REPLACEMENTS"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Fill Open Spots"
            android:textColor="#000000"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Entrants will be randomly drawn from the second-chance waitlist to fill any cancelled or unassigned slots."
            android:textAlignment="center"
            android:textColor="#333333"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_draw_confirm"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dialog_action_button_height"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_filled"
            app:backgroundTint="@null"
            android:text="DRAW &amp; NOTIFY"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>