<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_user_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <View
        android:id="@+id/profile_header"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_profile_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="92dp"
        android:layout_height="92dp"
        app:layout_constraintTop_toTopOf="@+id/profile_header"
        app:layout_constraintBottom_toBottomOf="@+id/profile_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/avatar_card"
            android:layout_width="92dp"
            android:layout_height="92dp"
            app:cardCornerRadius="46dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="true"
            app:cardUseCompatPadding="false">

            <ImageView
                android:id="@+id/avatar_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person_24" />
        </androidx.cardview.widget.CardView>


        <ImageButton
            android:id="@+id/btnEditAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_edit_avatar_badge"
            android:contentDescription="Edit profile"
            android:elevation="4dp"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_edit_24"
            app:tint="@color/black" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="John Doe"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/profile_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtContact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="yourname@domain.com | +1 231 567 "
        android:textColor="#757575"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/txtName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profile_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtContact">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="6dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowEditProfile"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:id="@+id/iconEdit" android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_description_24" app:tint="@color/black" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Edit profile information" android:textColor="@color/black" android:textSize="14sp" app:layout_constraintStart_toEndOf="@id/iconEdit" app:layout_constraintEnd_toStartOf="@id/arrowEdit" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <ImageView android:id="@+id/arrowEdit" android:layout_width="18dp" android:layout_height="18dp" app:srcCompat="@drawable/outline_arrow_forward_ios_24" app:tint="@color/black" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:id="@+id/iconNotif" android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_notifications_24" app:tint="@color/black" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Notifications" android:textColor="@color/black" android:textSize="14sp" app:layout_constraintStart_toEndOf="@id/iconNotif" app:layout_constraintEnd_toStartOf="@id/arrowNotif" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <ImageView android:id="@+id/arrowNotif" android:layout_width="18dp" android:layout_height="18dp" app:srcCompat="@drawable/outline_arrow_forward_ios_24" app:tint="@color/black" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowNotificationSettings"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:id="@+id/iconNotifSettings" android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_description_24" app:tint="@color/black" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Notification Settings" android:textColor="@color/black" android:textSize="14sp" app:layout_constraintStart_toEndOf="@id/iconNotifSettings" app:layout_constraintEnd_toStartOf="@id/arrowNotifSettings" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <ImageView android:id="@+id/arrowNotifSettings" android:layout_width="18dp" android:layout_height="18dp" app:srcCompat="@drawable/outline_arrow_forward_ios_24" app:tint="@color/black" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="6dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowTC"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:id="@+id/iconTerms" android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_favorite_24" app:tint="@color/black" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Terms and Conditions" android:textColor="@color/black" android:textSize="14sp" app:layout_constraintStart_toEndOf="@id/iconTerms" app:layout_constraintEnd_toStartOf="@id/arrowTerms" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                    <ImageView android:id="@+id/arrowTerms" android:layout_width="18dp" android:layout_height="18dp" app:srcCompat="@drawable/outline_arrow_forward_ios_24" app:tint="@color/black" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowDeleteProfile"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:id="@+id/iconDelete" android:layout_width="20dp" android:layout_height="20dp" app:srcCompat="@drawable/ic_delete_24" app:tint="@color/danger" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Delete Profile" android:textColor="@color/danger" android:textSize="14sp" app:layout_constraintStart_toEndOf="@id/iconDelete" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>