<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".view.EventsListActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top Navigation Area -->
    <LinearLayout
        android:id="@+id/top_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore"
                android:textSize="16sp"
                android:textColor="#333333" />

            <TextView
                style="@style/TxtTitle"
                android:textColor="#FF3B5C"
                android:text="Your Community!" />
        </LinearLayout>
            <!-- Search Icon -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_image_placeholder2"
            app:tint="#333333" />
    </LinearLayout>

    <!-- Selection Tabs -->
    <!-- Featured Events Header -->
    <LinearLayout
        android:id="@+id/featured_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@+id/top_nav">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Featured Events"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View All"
            android:textColor="#FF3B5C"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Content Area (Placeholder) -->

    <!-- Bottom navigation -->
    <ListView
        android:id="@+id/event_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="12dp"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/featured_header"
        app:layout_constraintVertical_bias="1.0"
        tools:listitem="@layout/item_event_card" />

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#FAFAFA"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_home"
            android:src="@drawable/ic_home"
            android:scaleType="centerInside"
            android:padding="8dp"
            app:tint="@color/primary_red" />

        <ImageButton
            android:id="@+id/nav_my_events"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_my_events"
            android:src="@drawable/ic_confirmation_number"
            android:scaleType="centerInside"
            android:padding="8dp"
            app:tint="#757575" />

        <ImageButton
            android:id="@+id/nav_create_event"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_create_event"
            android:src="@drawable/ic_add_box"
            android:scaleType="centerInside"
            android:padding="8dp"
            app:tint="#757575" />

        <ImageButton
            android:id="@+id/nav_scan_qr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_scan_qr"
            android:src="@drawable/ic_qr_code_scanner"
            android:scaleType="centerInside"
            android:padding="8dp"
            app:tint="#757575" />

        <ImageButton
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_profile"
            android:src="@drawable/ic_person"
            android:scaleType="centerInside"
            android:padding="8dp"
            app:tint="#757575" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>