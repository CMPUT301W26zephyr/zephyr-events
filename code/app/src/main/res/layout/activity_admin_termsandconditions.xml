<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/button_back2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="#000000" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Terms &amp; Conditions"
            android:textColor="#FF3B3B"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/button_edit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:background="#EDEDED">

            <!-- Last Edited -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="Last edited by Admin John Doe"
                android:textSize="12sp"
                android:textColor="#000000"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:text="February 20, 2026 at 14:32 (UTC)"
                android:textSize="12sp"
                android:textColor="#666666" />

            <!-- Terms Text -->
            <EditText
                android:id="@+id/terms_content"
                android:layout_width="match_parent"
                android:layout_height="466dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="#FFFFFF"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:lineSpacingExtra="4dp"
                android:padding="12dp"
                android:text="All users who join an event’s waitlist will be entered into a random draw once registration closes. Every entrant has an equal chance of being selected.

Selected entrants will be notified to claim their spot; if they don’t respond or decline, someone from the waiting list will be chosen.

Everyone who joins the draw will be notified of the results. The lottery process is fully transparent and impartial. Event organizers and administrators cannot influence lottery outcomes.

The information you provide is used only for event registration and communication within the app. It will never be used or shared for any external purpose.

Organizers are responsible for ensuring that event details such as time, date, and requirements are accurate before publishing.

By pressing I agree, you acknowledge that selection is based on chance and agree to these terms. Entering the lottery does not guarantee a spot in the event."
                android:textColor="#777777"
                android:textSize="13sp"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical" />

        </LinearLayout>

    </ScrollView>

    <!-- Edit Button (Admin only) -->
    <Button
        android:id="@+id/button_edit"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:backgroundTint="#FF3B3B"
        android:text="Edit"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>