<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ZephyrEvents" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <!-- Avoid purple/lavender Material alert surfaces; keep dialogs white. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Zephyr.MaterialAlertDialog</item>
    </style>

    <style name="ThemeOverlay.Zephyr.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/white</item>
        <item name="colorPrimary">@color/primary_red</item>
    </style>

    <style name="Theme.ZephyrEvents" parent="Base.Theme.ZephyrEvents" />

    <style name="FormLabelRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_marginTop">20dp</item>
    </style>

    <style name="FormAsterisk">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">*</item>
        <item name="android:textColor">#F44336</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FormLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#555555</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginStart">2dp</item>
    </style>

    <style name="FormInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_input_default</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textColorHint">#888888</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CustomMaterialCalendar" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/primary_red</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <style name="CustomInlineCalendar" parent="Theme.AppCompat.Light">
        <item name="colorAccent">@color/primary_red</item>
        <item name="colorPrimary">@color/primary_red</item>
    </style>

    <style name="ThemeOverlay.FilterAvailabilityPicker" parent="Theme.AppCompat.Light">
        <item name="colorAccent">@color/picker_coral</item>
        <item name="colorPrimary">@color/picker_coral</item>
        <item name="android:colorControlActivated">@color/picker_coral</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary_red</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_app_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ZephyrEvents</item>
    </style>

    <!-- Primary button -->
    <style name="Button.Filled" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_button_filled</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- Secondary button -->
    <style name="Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textColor">#FF3B5C</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- Title Text -->
    <style name="TxtTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#333333</item>
    </style>

    <!-- Subtitle Text -->
    <style name="TxtSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#999999</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- Terms of Service Body Text -->
    <style name="TxtTos">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#666666</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="SignupFormInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_input_default</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textColorHint">#888888</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">16sp</item>
    </style>


</resources>